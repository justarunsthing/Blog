@using Blog.Services
@model IEnumerable<global::Blog.Controllers.UsersController.UserRow>
@inject SiteClock clock
@{
    ViewData["Title"] = "Users";
    ViewData["MainText"] = "Users";
    ViewData["SubText"] = "Unlock or disable an account, or send a reset or confirmation mail.";
}
@if (TempData["UserMessage"] is string message)
{
    <div class="alert alert-success" role="alert">@message</div>
}
<div class="table-wrap">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Confirmed</th>
                <th>Locked</th>
                <th>Disabled</th>
                <th>Roles</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.User.FullName</td>
                    <td>@row.User.Email</td>
                    <td>@(row.User.EmailConfirmed ? "Yes" : "No")</td>
                    <td>@(row.Locked && row.User.LockoutEnd != null ? clock.FormatTime(row.User.LockoutEnd.Value.UtcDateTime) : "No")</td>
                    <td>@(row.User.Disabled ? "Yes" : "No")</td>
                    <td>@(row.Roles.Any() ? string.Join(", ", row.Roles) : "User")</td>
                    <td>
                        @if (row.Locked)
                        {
                            <form asp-action="Unlock" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@row.User.Id" />
                                <button type="submit" class="btn btn-sm btn-dark">Unlock</button>
                            </form>
                        }
                        @if (row.User.Disabled)
                        {
                            <form asp-action="Enable" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@row.User.Id" />
                                <button type="submit" class="btn btn-sm btn-dark">Enable</button>
                            </form>
                        }
                        else if (!row.IsAdministrator)
                        {
                            <form asp-action="Disable" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@row.User.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-ink">Disable</button>
                            </form>
                        }
                        <form asp-action="SendPasswordReset" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@row.User.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-ink">Send reset</button>
                        </form>
                        @if (!row.User.EmailConfirmed)
                        {
                            <form asp-action="SendConfirmation" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@row.User.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-ink">Send confirmation</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>