@using Blog.Enums
@using Blog.Interfaces
@using Microsoft.AspNetCore.Identity
@using X.PagedList
@using X.PagedList.Mvc.Core

@model IPagedList<Post>
@inject IImageService imageService
@inject UserManager<BlogUser> userManager

@{
    ViewData["Title"] = "Posts";
    ViewData["MainText"] = "Posts";
    ViewData["SubText"] = "Published pieces from this blog.";
    ViewData["HeaderImage"] = "/img/tim-mossholder-IQJbbw72PZc-unsplash.jpg";
}

<div class="section-head">
    <div>
        <p class="eyebrow">Archive</p>
        <h2>Published posts</h2>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <p>Nothing published in this blog yet.</p>
    </div>
}
else
{
    <div class="story-grid">
        @foreach (var post in Model)
        {
            var isAuthor = User.Identity.IsAuthenticated && post.AuthorId == userManager.GetUserId(User);
            var image = imageService.DecodeImage(post.ImageData, post.ContentType);
            if (string.IsNullOrEmpty(image))
            {
                image = "/img/post-sample-image.jpg";
            }

            <article class="story-card">
                <a class="story-card-media" asp-action="Details" asp-route-slug="@post.Slug">
                    <img src="@image" alt="" />
                </a>
                <div class="story-card-body">
                    <p class="story-meta">@post.Created.ToString("dd MMM yyyy")</p>
                    <h3>@post.Title</h3>
                    <p class="card-text">@post.Abstract</p>
                    <div class="story-actions">
                        <a class="btn btn-dark" asp-action="Details" asp-route-slug="@post.Slug">Read</a>
                        @if (User.IsInRole(BlogRole.Administrator.ToString()) || isAuthor)
                        {
                            <a class="btn btn-outline-ink" asp-action="Edit" asp-route-id="@post.Id">Edit</a>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
}

@if (Model.Any())
{
    <nav class="pager-bar" aria-label="Post pages">
        <p>Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</p>
        @Html.PagedListPager(Model, page => Url.Action("BlogPostIndex", new { id = Model.First().BlogId, page = page }),
            new PagedListRenderOptions
            {
                UlElementClasses = new string[] { "pagination", "mb-0" },
                LiElementClasses = new string[] { "page-item" },
                PageClasses = new string[] { "page-link" }
            })
    </nav>
}
