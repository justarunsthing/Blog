@using Blog.Enums
@using Blog.Interfaces
@using Blog.ViewModels
@using Microsoft.AspNetCore.Identity
@model PostDetailViewModel
@inject IImageService imageService
@inject UserManager<BlogUser> userManager

<div class="post-layout">
    <article>
        @{
            var cover = imageService.DecodeImage(Model.Post.ImageData, Model.Post.ContentType);
        }
        @if (!string.IsNullOrEmpty(cover))
        {
            <img class="post-cover" src="@cover" alt="" />
        }
        <div class="post-body">
            @Html.Raw(Model.Post.Content)
        </div>
        @if (Model.Post.Tags.Any())
        {
            <div class="post-tags mt-4">
                @foreach (var tag in Model.Post.Tags)
                {
                    <a class="tag-chip" asp-action="TagIndex" asp-route-tag="@tag.Text.ToLower()">#@tag.Text</a>
                }
            </div>
        }
    </article>
    @if (Model.Tags.Any())
    {
        <aside class="post-aside">
            <h2>All tags</h2>
            <div class="tag-scroll">
                @foreach (var tag in Model.Tags)
                {
                    <a class="tag-chip" asp-action="TagIndex" asp-route-tag="@tag">#@tag</a>
                }
            </div>
        </aside>
    }
</div>

<section class="comments" id="comment-section">
    <p class="eyebrow">Discussion</p>
    <h2>@Model.Post.Comments.Count comment@(Model.Post.Comments.Count == 1 ? "" : "s")</h2>

    @if (User.Identity.IsAuthenticated)
    {
        <form asp-controller="Comments" asp-action="Create" method="post" class="mt-3">
            @Html.Hidden("PostId", Model.Post.Id)
            <div class="form-group">
                <label class="control-label" for="comment-body">Add a comment</label>
                <textarea id="comment-body" name="body" class="form-control" rows="5"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    }
    else
    {
        <a class="btn btn-dark mt-3" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="~/Posts/Details?slug=@Model.Post.Slug">
            Login to add a comment
        </a>
    }

    @{
        var counter = 0;
    }

    <div class="mt-4">
        @foreach (var comment in Model.Post.Comments.OrderByDescending(c => c.Created))
        {
            var avatar = imageService.DecodeImage(comment.Author?.ImageData, comment.Author?.ContentType);
            <article class="comment-card">
                @if (!string.IsNullOrEmpty(avatar))
                {
                    <img src="@avatar" alt="" />
                }
                else
                {
                    <img src="/img/default-image-user.jpg" alt="" />
                }
                <div>
                    <h3>@comment.Author?.FullName</h3>
                    <p class="story-meta">
                        @if (comment.Moderated != null)
                        {
                            <span>Moderated (@comment.ModerationType.ToString().ToLower()) · @comment.Moderated?.ToString("dd MMM yyyy")</span>
                        }
                        else
                        {
                            <span>@comment.Created.ToString("dd MMM yyyy")</span>
                        }
                    </p>
                    @if (string.IsNullOrEmpty(comment.Body))
                    {
                        <p>Comment not available</p>
                    }
                    else if (comment.Moderated != null)
                    {
                        <p>@comment.ModeratedBody</p>
                    }
                    else if (comment.Deleted == null)
                    {
                        <p>@comment.Body</p>
                    }

                    <div class="comment-actions">
                        @if (comment.Moderated == null && comment.Deleted == null && comment.AuthorId == userManager.GetUserId(User))
                        {
                            <button type="button" data-bs-toggle="modal" data-bs-target="@($"#edit-comment-modal-{counter}")" class="btn btn-sm btn-outline-ink">Edit</button>
                        }
                        @if (User.IsInRole(BlogRole.Moderator.ToString()) && comment.Deleted == null)
                        {
                            <button type="button" class="btn btn-sm btn-dark" data-bs-toggle="modal" data-bs-target="@($"#moderate-comment-modal-{counter}")">Moderate</button>
                            <form asp-controller="Comments" asp-action="Delete">
                                @Html.Hidden("Id", comment.Id)
                                @Html.Hidden("Slug", comment.Post.Slug)
                                <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                            </form>
                        }
                    </div>
                </div>
            </article>

            <div id="@($"edit-comment-modal-{counter}")" class="modal fade" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="modal-title">Edit comment</h4>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form asp-controller="Comments" asp-action="Edit" method="post">
                                @Html.Hidden("Id", comment.Id)
                                <div class="form-group">
                                    <textarea name="Body" class="form-control" rows="5" required>@comment.Body</textarea>
                                </div>
                                <button class="btn btn-dark" type="submit">Save</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="@($"moderate-comment-modal-{counter}")" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="modal-title">Moderate comment</h4>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form asp-controller="Comments" asp-action="Moderate" method="post">
                                @Html.Hidden("Id", comment.Id)
                                @Html.Hidden("Body", comment.Body)
                                <div class="form-group">
                                    <label class="control-label">Original comment</label>
                                    <textarea disabled class="form-control" rows="4">@comment.Body</textarea>
                                </div>
                                <div class="form-group">
                                    <label class="control-label">Moderated comment</label>
                                    <textarea required name="ModeratedBody" class="form-control" rows="4">@comment.ModeratedBody</textarea>
                                </div>
                                <div class="form-group">
                                    <label class="control-label">Reason</label>
                                    <select class="form-control" asp-for="@comment.ModerationType" name="ModerationType" asp-items="Html.GetEnumSelectList<ModerationType>()"></select>
                                </div>
                                <button class="btn btn-dark" type="submit">Save moderation</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            counter++;
        }
    </div>
</section>
