@model IEnumerable<Post>
@using Blog.Enums
@using Blog.Interfaces
@using Microsoft.AspNetCore.Identity
@inject IImageService imageService
@inject UserManager<BlogUser> userManager

@{
    ViewData["Title"] = "Posts";
    ViewData["MainText"] = "All posts";
    ViewData["SubText"] = User.IsInRole(BlogRole.Administrator.ToString())
        ? "Drafts and published pieces, in one list."
        : User.Identity.IsAuthenticated
            ? "Published posts, plus your drafts."
            : "Published posts.";
    ViewData["HeaderImage"] = "/img/post-sample-image.jpg";
}

<div class="section-head">
    <div>
        <p class="eyebrow">Library</p>
        <h2>All posts</h2>
    </div>
</div>

@if (User.IsInRole(BlogRole.Administrator.ToString()))
{
    <p>
        <a class="btn btn-dark mb-3" asp-action="Create">New post</a>
    </p>
}
<div class="table-wrap">
<table class="table align-middle">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Abstract)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Created)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Image)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Abstract)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Created)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <th>
                <img class="img-fluid" width="200px" src="@imageService.DecodeImage(item.ImageData, item.ContentType)" />
            </th>
            <td>
                @if (User.IsInRole(BlogRole.Administrator.ToString()) || item.AuthorId == userManager.GetUserId(User))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <span> | </span>
                }
                <a asp-action="Details" asp-route-slug="@item.Slug">Details</a>
                @if (User.IsInRole(BlogRole.Administrator.ToString()) || item.AuthorId == userManager.GetUserId(User))
                {
                    <span> | </span>
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
</div>
