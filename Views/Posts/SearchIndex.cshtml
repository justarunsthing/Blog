@using Blog.Services
@using Microsoft.AspNetCore.Identity
@using X.PagedList
@using X.PagedList.Mvc.Core

@inject UserManager<BlogUser> userManager
@inject SiteClock clock
@model IPagedList<Post>

@{
    ViewData["Title"] = "Search";
    ViewData["MainText"] = "Search";
    ViewData["SubText"] = string.IsNullOrWhiteSpace(ViewData["SearchTerm"] as string)
        ? "Look through published posts."
        : $"Results for \"{ViewData["SearchTerm"]}\"";
    ViewData["ShowSearchBar"] = true;
}

@if (!Model.Any())
{
    <div class="empty-state">
        <p>No published posts matched that search.</p>
    </div>
}
else
{
    <div class="story-grid">
        @foreach (var post in Model)
        {
            <article class="story-card">
                <a class="story-card-media" asp-action="Details" asp-route-slug="@post.Slug">
                    @if (!string.IsNullOrWhiteSpace(post.ContentType))
                    {
                        <img src="/media/posts/@post.Id?v=@((post.Updated ?? post.Created).Ticks)" alt="@post.Title" />
                    }
                </a>
                <div class="story-card-body">
                    <p class="story-meta">@clock.Format(post.Published ?? post.Created)</p>
                    <h3>@post.Title</h3>
                    <p class="card-text">@post.Abstract</p>
                    <div class="story-actions">
                        <a class="btn btn-dark" asp-action="Details" asp-route-slug="@post.Slug">Read</a>
                    </div>
                </div>
            </article>
        }
    </div>
}

<nav class="pager-bar" aria-label="Search pages">
    <p>Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</p>
    @Html.PagedListPager(Model, page => Url.Action("SearchIndex", new { page = page, searchTerm = ViewData["SearchTerm"] }),
        new PagedListRenderOptions
        {
            UlElementClasses = new string[] { "pagination", "mb-0" },
            LiElementClasses = new string[] { "page-item" },
            PageClasses = new string[] { "page-link" }
        })
</nav>
