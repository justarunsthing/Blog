@model Blog

@{
    ViewData["Title"] = "justarunsthing's - Create Blog";
    ViewData["MainText"] = "New blog";
    ViewData["SubText"] = "Give a subject its own shelf.";
    ViewData["HeaderImage"] = "/img/drew-beamer-3SIXZisims4-unsplash.jpg";
}

<div class="editor">
    <p class="eyebrow">Writing</p>
    <h1>Create blog</h1>
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Image" class="control-label"></label>
                <input type="file" asp-for="Image" class="form-control" accept=".jpg,.png,.gif,.jpeg" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary w-100 my-3" />
            </div>
        </form>
    <a asp-action="Index">Back to blogs</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
