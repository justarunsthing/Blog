@using Blog.Enums
@using Blog.Interfaces
@using Microsoft.AspNetCore.Identity
@using X.PagedList
@using X.PagedList.Mvc.Core
@inject IImageService imageService
@inject UserManager<BlogUser> userManager

@model IPagedList<Blog>

@{
    ViewData["Title"] = "justarunsthing's Tech Blog - Home";
    ViewData["MainText"] = "justarunsthing";
    ViewData["SubText"] = "Writing about software, side projects, and the details that usually stay in a notebook.";
    ViewData["HeaderImage"] = "/img/nasa-Q1p7bh3SHj8-unsplash.jpg";
    ViewData["ShowSearchBar"] = true;
}

<div class="section-head">
    <div>
        <p class="eyebrow">The collection</p>
        <h2>Latest blogs</h2>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <p>No published blogs yet. Once a post is marked Production, its blog shows up here.</p>
    </div>
}
else
{
    <div class="story-grid">
        @foreach (var blog in Model)
        {
            var image = imageService.DecodeImage(blog.ImageData, blog.ContentType);
            if (string.IsNullOrEmpty(image))
            {
                image = "/img/home-bg.jpg";
            }

            <article class="story-card">
                <a class="story-card-media" asp-controller="Posts" asp-action="BlogPostIndex" asp-route-id="@blog.Id">
                    <img src="@image" alt="" />
                </a>
                <div class="story-card-body">
                    <p class="story-meta">@blog.Created.ToString("dd MMM yyyy")@(blog.Author != null ? $" · {blog.Author.FullName}" : "")</p>
                    <h3>@blog.Name</h3>
                    <p class="card-text" title="@blog.Description">@blog.Description</p>
                    <div class="story-actions">
                        <a class="btn btn-dark" asp-controller="Posts" asp-action="BlogPostIndex" asp-route-id="@blog.Id">Read posts</a>
                        @if (User.IsInRole(BlogRole.Administrator.ToString()))
                        {
                            <a class="btn btn-outline-ink" asp-controller="Posts" asp-action="Create" asp-route-id="@blog.Id">New post</a>
                            <a class="btn btn-outline-ink" asp-controller="Blogs" asp-action="Edit" asp-route-id="@blog.Id">Edit</a>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
}

<nav class="pager-bar" aria-label="Blog pages">
    <p>Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</p>
    @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }),
        new PagedListRenderOptions
        {
            UlElementClasses = new string[] { "pagination", "mb-0" },
            LiElementClasses = new string[] { "page-item" },
            PageClasses = new string[] { "page-link" }
        })
</nav>

@section Scripts {
    <script>
        var swalMsg = '@TempData["SweetAlert"]'

        if (swalMsg != "") {
            Swal.fire({
                icon: 'success',
                title: swalMsg,
                timer: 3000
            })
        }
    </script>
}
