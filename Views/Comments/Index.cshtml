@model IEnumerable<Comment>

@{
    ViewData["Title"] = "Comments";
    ViewData["MainText"] = "Comments";
    ViewData["SubText"] = "Every comment on the site.";
    ViewData["HeaderImage"] = "/img/damian-zaleski-RYyr-k3Ysqg-unsplash.jpg";
}

<div class="section-head">
    <div>
        <p class="eyebrow">Moderation</p>
        <h2>All comments</h2>
    </div>
</div>

<p>
    <a class="btn btn-dark mb-3" asp-action="Create">New comment</a>
</p>
<div class="table-wrap">
<table class="table align-middle">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Body)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Created)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Updated)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Moderated)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Deleted)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ModeratedBody)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ModerationType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Post)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Author)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Moderator)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Body)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Created)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Updated)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Moderated)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Deleted)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ModeratedBody)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ModerationType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Post.Abstract)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Author.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Moderator.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
