<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
	<meta name="description" content="justarunsthing's Tech Blog" />
	<meta name="author" content="justarunsthing" />

	<title>@ViewData["Title"]</title>

	<script src="//use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
	<link href="//fonts.googleapis.com/css?family=Lora:400,700,400italic,700italic" rel="stylesheet" type="text/css" />
	<link href="//fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,800italic,400,300,600,700,800" rel="stylesheet" type="text/css" />
	<link href="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.css" rel="stylesheet">
	<link href="~/css/styles.css" rel="stylesheet" />
	<link href="~/css/custom.css" rel="stylesheet" />
</head>
<body>
	@{
		var headerImage = ViewData["HeaderImage"] as string;
		if (string.IsNullOrWhiteSpace(headerImage))
		{
			headerImage = "/img/nasa-Q1p7bh3SHj8-unsplash.jpg";
		}

		var photoHeader = !headerImage.StartsWith("data:", StringComparison.OrdinalIgnoreCase);

		var mainText = ViewData["MainText"] as string;
		if (string.IsNullOrWhiteSpace(mainText))
		{
			mainText = "justarunsthing";
		}

		var subText = ViewData["SubText"] as string ?? "Notes on software, projects, and the work in between.";
		var showSearch = ViewData["ShowSearchBar"] is bool searchOn && searchOn;
	}

	<nav class="navbar navbar-expand-lg" id="mainNav">
		<div class="container px-4 px-lg-5">
			<a class="navbar-brand" asp-controller="Home" asp-action="Index">
				<span class="brand-mark">ja</span>
				<span class="brand-name">justarun<span>sthing</span></span>
			</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
				Menu
				<i class="fas fa-bars"></i>
			</button>
			<div class="collapse navbar-collapse" id="navbarResponsive">
				<ul class="navbar-nav ms-auto py-3 py-lg-0">
					<li class="nav-item">
						<a class="nav-link px-lg-3 py-2 py-lg-3" asp-controller="Home" asp-action="Index">Home</a>
					</li>
					<li class="nav-item">
						<a class="nav-link px-lg-3 py-2 py-lg-3" asp-controller="Home" asp-action="About">About</a>
					</li>
					<li class="nav-item">
						<a class="nav-link px-lg-3 py-2 py-lg-3" asp-controller="Home" asp-action="Contact">Contact</a>
					</li>
					@if (User.IsInRole("Administrator"))
					{
						<li class="nav-item">
							<a class="nav-link px-lg-3 py-2 py-lg-3" asp-controller="Blogs" asp-action="Create">Create Blog</a>
						</li>
						<li class="nav-item">
							<a class="nav-link px-lg-3 py-2 py-lg-3" asp-controller="Posts" asp-action="Create">Create Posts</a>
						</li>
					}
				</ul>
				<partial name="_LoginPartial" />
			</div>
		</div>
	</nav>

	<header class="masthead@(photoHeader ? "" : " masthead-plain")" style="@(photoHeader ? $"background-image: url('{headerImage}')" : null)">
		<div class="container position-relative px-4 px-lg-5">
			<div class="row gx-4 gx-lg-5 justify-content-center">
				<div class="col-md-10 col-lg-8 col-xl-7">
					<div class="site-heading">
						<h1>@mainText</h1>
						<span class="subheading">@subText</span>

						@if (showSearch)
						{
							<form class="mast-search" asp-action="SearchIndex" asp-controller="Posts">
								<div class="input-group">
									<input type="text" name="SearchTerm" class="form-control" placeholder="Search posts" value="@ViewData["SearchTerm"]" />
									<button class="btn btn-primary" type="submit">Search</button>
								</div>
							</form>
						}
					</div>
				</div>
			</div>
		</div>
	</header>

	<main class="site-main">
		<div class="container px-4 px-lg-5">
			@RenderBody()
		</div>
	</main>

	<footer class="site-footer">
		<div class="container px-4 px-lg-5 text-center">
			<a class="footer-brand" asp-controller="Home" asp-action="Index">justarunsthing</a>
			<div class="mt-3">
				<a class="social-link" href="https://github.com/justarunsthing" target="_blank" aria-label="GitHub">
					<i class="fab fa-github"></i>
				</a>
				<a class="social-link" href="https://www.instagram.com/justarunsthing" target="_blank" aria-label="Instagram">
					<i class="fab fa-instagram"></i>
				</a>
			</div>
			<div class="footer-copy">Copyright &copy; justarunsthing @DateTime.Now.Year</div>
		</div>
	</footer>

	<script src="https://code.jquery.com/jquery-3.7.1.slim.min.js" integrity="sha256-kmHvs0B+OpCW5GVHUNjv9rOmY0IvSIRcf7zGUDTDQM8=" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js" integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.js"></script>
	<script src="~/js/scripts.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
